# Dependencies
/node_modules
/.pnp
.pnp.js

# Environment files. Only .env.example is committed: Vite loads .env.<mode> exactly the way it
# loads .env, so a mode file is no safer to commit, and anything in one is published the moment
# it is prefixed VITE_. Real values come from the environment — GitHub Actions variables for the
# deploy, a local .env for development.
.env
.env.*
!.env.example

# Build files
/dist
/build

# Lint cache — lint-staged runs `eslint --cache` on every commit.
.eslintcache

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor files
.vscode/*
!.vscode/extensions.json
.idea
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# macOS system files
.DS_Store
.AppleDouble
.LSOverride
._*
# Test artifacts
/test-results
/playwright-report
/blob-report
/playwright/.cache
/coverage
