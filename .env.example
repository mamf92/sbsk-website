# Copy to .env for local development. Vite only exposes variables prefixed with VITE_ to the
# client, and every one of them ends up readable in the built bundle.
#
# Do NOT put secrets in frontend env vars, and do NOT commit a filled-in copy. .env and every
# .env.<mode> file are gitignored; this example is the only environment file in the repository.
# The deploy reads its values from GitHub Actions variables (see .github/workflows/ci.yml).

# Base path the app is served from. `/` locally; the deploy derives `/sbsk-website/` from the
# repository name, so it does not need to be set here.
VITE_BASE=/

# Supabase project. The URL needs its https:// scheme — createClient throws without it.
# The publishable key is the anon key; it is public by design and RLS is what protects the data.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
